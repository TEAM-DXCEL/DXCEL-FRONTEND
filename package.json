{
  "name": "dxcel-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.3.1 <27",
    "pnpm": "10.34.9"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "sirv out --host 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
